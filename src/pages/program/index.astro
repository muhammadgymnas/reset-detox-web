---
import Base from '../../layouts/Base.astro';
import { Image } from 'astro:assets';
import { img } from '../../lib/images';
import catalog from '../../data/catalog.json';
import { rupiah } from '../../scripts/cart';
const resets = catalog.programs.filter((p) => p.line === 'reset-program').sort((a, b) => b.days - a.days);
const ren = catalog.programs.filter((p) => p.line === 'renourish').sort((a, b) => b.days - a.days);
---
<Base title="Program · Reset Detox" description="Reset 1, 3, dan 5 hari, plus ReNourish. Harga untuk formula perempuan dan laki-laki.">
  <section class="ch top" data-field="day" aria-labelledby="pg-title">
    <h1 id="pg-title" data-rise>Program</h1>
    <p class="lead" data-rise style="--i:1">Lima hari adalah programnya. Satu dan tiga hari adalah pintu masuk. ReNourish adalah langkah sesudahnya.</p>
  </section>
  <section class="ch list" data-field="paper" aria-labelledby="reset-h">
    <h2 id="reset-h" data-rise>Reset</h2>
    <div class="table" role="table" aria-label="Perbandingan program Reset">
      <div class="tr th" role="row"><span role="columnheader">Program</span><span role="columnheader">Perempuan</span><span role="columnheader">Laki-laki</span><span role="columnheader">Kirim</span><span role="columnheader"><span class="visually-hidden">Aksi</span></span></div>
      {resets.map((p) => (
        <div class="tr" role="row" data-rise>
          <span role="cell" class="pn"><Image src={img(p.photo)} alt={p.name} width={240} height={240} /><strong>{p.name}</strong></span>
          <span role="cell" class="num">{rupiah(p.formulas[0].price)}<small>{p.formulas[0].bottles} botol</small></span>
          <span role="cell" class="num">{rupiah(p.formulas[1].price)}<small>{p.formulas[1].bottles} botol</small></span>
          <span role="cell" class="small">{p.delivery}</span>
          <span role="cell"><a class="btn" href={p.url}>Pilih</a></span>
        </div>
      ))}
    </div>
  </section>
  <section class="ch list" data-field="shot" aria-labelledby="ren-h">
    <h2 id="ren-h" data-rise>ReNourish</h2>
    <p class="lead sub" data-rise>Untuk yang sudah pernah Reset: Body Nourish Meal dengan Avocado Hope, Passion Berries, Love Beet, Overwhelm Acai, dan WheatGrace.</p>
    <div class="ren">
      {ren.map((p) => (
        <a class="ren-card" href={p.url} data-rise>
          <Image src={img(p.photo)} alt={p.name} widths={[500, 900]} sizes="(max-width: 860px) 90vw, 45vw" loading="lazy" />
          <span class="lead"><strong>{p.name}</strong></span>
          <span class="num">Perempuan {rupiah(p.formulas[0].price)} · Laki-laki {rupiah(p.formulas[1].price)}</span>
        </a>
      ))}
    </div>
    <p class="small" style="margin-top:32px">Formula Higher Protein dan Breastfeeding Mom tersedia lewat konsultasi admin. Harga per {catalog.price_as_of}.</p>
  </section>
</Base>
<style>
  .top { min-height: 64svh; display: grid; align-content: end; gap: 20px; padding-top: 140px; }
  .top h1 { font-size: var(--s-hero); font-stretch: 118%; line-height: 0.85; letter-spacing: -0.035em; padding-bottom: 0.14em; } /* room for the descenders before the line below */
  .list h2 { margin-bottom: 40px; }
  .sub { margin: -16px 0 40px; }
  .table { display: grid; gap: 4px; }
  .tr { display: grid; grid-template-columns: 2fr 1fr 1fr 1.4fr auto; gap: 16px; align-items: center; padding: 16px 20px; background: var(--stone); }
  .th { background: transparent; font-weight: 700; font-size: var(--s-sm); padding-block: 8px; }
  .pn { display: flex; align-items: center; gap: 16px; font-size: var(--s-lead); }
  .pn img { width: 160px; height: 160px; object-fit: cover; mix-blend-mode: multiply; }
  .tr small { display: block; color: var(--ink-soft); font-size: var(--s-sm); }
  .tr .num { font-weight: 700; font-size: var(--s-lead); }
  .ren { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; }
  .ren-card { display: grid; gap: 8px; text-decoration: none; }
  .ren-card img { width: 100%; aspect-ratio: 4 / 3; object-fit: cover; transition: transform 500ms var(--ease-out); }
  .ren-card:hover img { transform: scale(1.02); }
  @media (max-width: 860px) {
    .th { display: none; }
    .tr { grid-template-columns: 1fr 1fr; }
    .pn { grid-column: span 2; }
    .tr .small { grid-column: span 2; }
    .tr .btn { width: 100%; }
    .tr > span:last-child { grid-column: span 2; }
    .ren { grid-template-columns: 1fr; }
  }
</style>
