---
import Base from '../layouts/Base.astro';
import site from '../data/site.json';
import { Image } from 'astro:assets';
import { img } from '../lib/images';
import Icon from '../components/Icon.astro';
const packs = [
  { n: 'Wellness Sampling', v: '20–30 botol per aktivasi', d: 'Untuk wellness day, seminar, gathering, atau apresiasi pelanggan.', field: 'broth', photo: 'reset-1d' },
  { n: 'Office Wellness', v: '50, 75, atau 100 botol per pesanan', d: 'Golden Water, Green Tonic, Coco Iskiate, Kombucha, Signature Mylk untuk pantry mingguan atau bulanan.', field: 'tonic', photo: 'reset-3d' },
  { n: 'Wellness Partnership', v: 'Gym, pilates, yoga, komunitas', d: 'Sampling ke member, lalu referral, bagi hasil, reseller, atau benefit member.', field: 'day', photo: 'renourish-5d' },
];
---
<Base title="Kontak & kerja sama · Reset Detox" description="WhatsApp untuk pesan dan pertanyaan, serta paket sampling, office wellness, dan partnership untuk kantor, gym, studio, dan event di Jabodetabek.">
  <section class="ch top" data-field="ink" aria-labelledby="k-title">
    <h1 id="k-title" data-rise>Kontak</h1>
    <p class="lead">Satu nomor untuk pesan, pertanyaan, kemitraan, dan kolaborasi. Pilih jalanmu.</p>
    <div class="paths">
      <a class="path" data-rise href="#pelanggan" style="--field:var(--stone)"><span class="pn">Pesan dan tanya</span><span>Untuk kamu yang ingin mulai, atau bertanya dulu.</span></a>
      <a class="path" data-rise href="#bisnis" style="--field:var(--broth)"><span class="pn">Kerja sama</span><span>Untuk kantor, gym, studio, komunitas, dan event.</span></a>
      <a class="path" data-rise href="#kolaborasi" style="--field:var(--tonic)"><span class="pn">Kolaborasi brand</span><span>Untuk kreator, media, dan brand lain.</span></a>
    </div>
  </section>

  <section class="ch b2c" id="pelanggan" data-field="stone" aria-labelledby="c-title">
    <div class="b2c-grid">
      <div class="b2c-main">
        <h2 id="c-title" data-rise>Pesan dan tanya</h2>
        <a class="wa-big num" data-rise style="--i:1" href={`https://wa.me/${site.whatsapp}?text=${encodeURIComponent('Halo Reset Detox, saya mau tanya dulu sebelum pesan.')}`} target="_blank" rel="noopener">+62 811 8880 3155</a>
        <p class="lead">Admin membalas {site.serviceHours}, setiap hari. Penjelasan dulu, tanpa paksaan membeli.</p>
        <div class="b2c-actions" data-rise style="--i:2">
          <a class="btn" href={`https://wa.me/${site.whatsapp}?text=${encodeURIComponent('Halo Reset Detox, saya mau tanya dulu sebelum pesan.')}`} target="_blank" rel="noopener"><Icon name="chat" /> Tanya di WhatsApp</a>
          <a class="btn ghost" href="/cek-kecocokan">Cek kecocokan dulu</a>
        </div>
      </div>
      <dl class="b2c-facts" data-rise>
        <div><dt>Dapur</dt><dd>Sunter Mas Timur Blok Z No. 5, Jakarta Utara</dd></div>
        <div><dt>Kirim ke</dt><dd>Jakarta, Tangerang &amp; Tangsel, Depok, Bekasi, Bogor. Di luar itu, tanya dulu.</dd></div>
        <div><dt>Instagram</dt><dd><a class="link" href={site.social.instagram} target="_blank" rel="noopener">@reset.detox</a></dd></div>
        <div><dt>Email</dt><dd><a class="link" href="mailto:hello@resetdetox.id">hello@resetdetox.id</a></dd></div>
        <div><dt>Sudah pesan?</dt><dd>Sebutkan nomor order RD-… di chat supaya admin langsung menemukannya.</dd></div>
      </dl>
      <Image src={img('holding-bottle')} alt="Tangan memegang Body Reset Meal Day" widths={[800, 1400]} sizes="100vw" loading="lazy" class="b2c-img" data-rise />
    </div>
  </section>

  <section class="ch b2b-head" id="bisnis" data-field="gw" aria-labelledby="b-title">
    <h2 id="b-title" data-rise>Kerja sama</h2>
    <p class="lead" data-rise style="--i:1">Untuk kantor, gym, studio, dan event di Jabodetabek. Botol yang sama, diantar dingin ke lokasi.</p>
  </section>
  {packs.map((p, i) => (
    <section class="pk" data-field={p.field} aria-labelledby={`pk-${i}`}>
      <h2 id={`pk-${i}`} data-rise>{p.n}</h2>
      <div class="pk-text" data-rise style="--i:1"><p class="lead"><strong>{p.v}</strong></p><p>{p.d}</p><Image src={img(p.photo)} alt="" widths={[500, 900]} sizes="(max-width: 860px) 90vw, 45vw" loading="lazy" class="pk-img" /></div>
    </section>
  ))}
  <section class="ch form" data-field="paper" aria-labelledby="f-title">
    <div class="fgrid">
      <div><h2 id="f-title" data-rise>Ajukan kerja sama</h2><p class="lead" style="margin-top:20px">Formulir ini membuka WhatsApp tim dengan detailmu tersusun. Penawaran resmi dan faktur pajak menyusul dari tim.</p></div>
      <form id="b2b" class="fields" data-rise style="--i:1" novalidate>
        <div class="field"><label for="bn">Nama PIC</label><input id="bn" name="name" required autocomplete="name" /></div>
        <div class="field"><label for="bc">Perusahaan, studio, atau komunitas</label><input id="bc" name="company" required autocomplete="organization" /></div>
        <div class="field"><label for="bt">Jenis kerja sama</label><select id="bt" name="type">{packs.map((p) => <option>{p.n}</option>)}<option>Lainnya</option></select></div>
        <div class="field"><label for="bv">Estimasi volume</label><input id="bv" name="volume" placeholder="50 botol per minggu, atau 200 botol untuk satu event" /></div>
        <div class="field"><label for="bd">Tanggal acara atau mulai</label><input id="bd" name="date" type="date" /></div>
        <div class="field"><label for="bx">Catatan</label><textarea id="bx" name="notes" rows="3"></textarea></div>
        <p class="err" data-b2b-err hidden>Isi nama PIC dan nama perusahaan dulu.</p>
        <button class="btn block" type="submit"><Icon name="chat" /> Kirim ke WhatsApp tim</button>
      </form>
    </div>
  </section>
  <section class="ch collab" id="kolaborasi" data-field="stone" aria-labelledby="collab-title">
    <h2 id="collab-title" data-rise>Kolaborasi brand</h2>
    <p class="lead" data-rise style="--i:1">Kreator, media, atau brand yang ingin bekerja sama dengan Reset Detox? Ceritakan idemu lewat WhatsApp atau email. Tim kami membalas dan membahas bentuk kerja samanya bersama.</p>
    <div class="collab-acts" data-rise style="--i:2">
      <a class="btn" href={`https://wa.me/${site.whatsapp}?text=${encodeURIComponent('Halo Reset Detox, saya mau tanya soal kolaborasi.')}`} target="_blank" rel="noopener"><Icon name="chat" /> Chat soal kolaborasi</a>
      <a class="btn ghost" href="mailto:hello@resetdetox.id?subject=Kolaborasi%20brand">hello@resetdetox.id</a>
    </div>
  </section>
</Base>
<style>
  .paths { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 8px; margin-top: 40px; }
  .path { display: grid; gap: 8px; padding: 28px; background: var(--field); color: var(--ink); text-decoration: none; transition: transform 200ms var(--ease-out); }
  .path:hover { transform: translateY(-4px); }
  .path:active { transform: scale(0.98); }
  .pn { font-size: clamp(1.75rem, 1rem + 2vw, 2.75rem); font-weight: 800; font-stretch: 112%; letter-spacing: -0.03em; line-height: 1; }
  .b2c-grid { display: grid; grid-template-columns: 1.2fr 1fr; gap: clamp(24px, 5vw, 80px); align-items: start; }
  .b2c-main { display: grid; gap: 24px; justify-items: start; }
  .wa-big { font-size: clamp(2.5rem, 1.4rem + 4vw, 5.5rem); font-weight: 800; font-stretch: 112%; letter-spacing: -0.03em; line-height: 1; text-decoration: none; }
  .wa-big:hover { color: var(--ink-soft); }
  .b2c-actions { display: flex; gap: 8px; flex-wrap: wrap; }
  .b2c-facts { margin: 0; display: grid; gap: 4px; }
  .b2c-facts div { display: grid; grid-template-columns: 120px 1fr; gap: 16px; padding: 16px 20px; background: var(--paper); }
  .b2c-facts dt { font-weight: 700; }
  .b2c-facts dd { margin: 0; }
  .pk-text { display: grid; gap: 12px; }
  .pk-img { width: 100%; aspect-ratio: 16 / 10; object-fit: cover; mix-blend-mode: multiply; margin-top: 16px; }
  .b2c-img { grid-column: 1 / -1; width: 100%; aspect-ratio: 16 / 9; object-fit: cover; object-position: 50% 94%; margin-top: 8px; }
  @media (max-width: 860px) { .b2c-img { aspect-ratio: 1 / 1; object-position: 0% 100%; } }
  .b2b-head { display: grid; grid-template-columns: 1fr 1fr; gap: 32px; align-items: end; }
  .b2b-head h2 { font-size: clamp(3rem, 8vw, 8rem); font-stretch: 116%; }
  .collab { display: grid; gap: 24px; justify-items: start; }
  .collab h2 { font-size: clamp(2rem, 0.9rem + 3.2vw, 4.25rem); }
  .collab-acts { display: flex; gap: 8px; flex-wrap: wrap; }
  @media (max-width: 860px) { .paths, .b2c-grid, .b2b-head { grid-template-columns: 1fr; } .b2c-facts div { grid-template-columns: 1fr; gap: 2px; } }
  .top { min-height: 64svh; display: grid; align-content: end; gap: 20px; padding-top: 140px; }
  .top h1 { font-size: var(--s-hero); font-stretch: 118%; line-height: 0.85; letter-spacing: -0.035em; padding-bottom: 0.14em; } /* room for the descenders before the line below */
  .pk { display: grid; grid-template-columns: 1fr 1fr; gap: 32px; align-items: end; min-height: 40svh; padding: 72px var(--m); background: var(--field); }
  .pk[data-field="broth"] { --field: var(--broth); } .pk[data-field="tonic"] { --field: var(--tonic); } .pk[data-field="day"] { --field: var(--day); }
  .fgrid { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(24px, 5vw, 80px); }
  .fields { display: grid; gap: 16px; }
  @media (max-width: 860px) { .pk, .fgrid { grid-template-columns: 1fr; } }
</style>
<script>
  import site from '../data/site.json';
  const f = document.getElementById('b2b') as HTMLFormElement;
  f.addEventListener('submit', (e) => {
    e.preventDefault();
    const d = new FormData(f);
    const err = f.querySelector<HTMLElement>('[data-b2b-err]')!;
    if (!String(d.get('name')).trim() || !String(d.get('company')).trim()) { err.hidden = false; return; }
    err.hidden = true;
    const t = ['Halo Tim Bisnis Reset Detox, saya ingin diskusi kerja sama.', '', `Nama PIC: ${d.get('name')}`, `Perusahaan: ${d.get('company')}`, `Jenis: ${d.get('type')}`, `Volume: ${d.get('volume') || '-'}`, `Tanggal: ${d.get('date') || '-'}`, `Catatan: ${d.get('notes') || '-'}`].join('\n');
    window.open(`https://wa.me/${site.whatsapp}?text=${encodeURIComponent(t)}`, '_blank', 'noopener');
  });
</script>
